Задача 8


a = float(input("Первое число: "))
b = float(input("Второе число: "))

action = input("Ведіть дію (+, -, *, /): ")

if action == "+":
    print("Результат:", a + b)
elif action == "-":
    print("Результат:", a - b)
elif action == "*":
    print("Результат:", a * b)
elif action == "/":
    if b == 0:
        print("Ділення на нуль")
    else:
        print("Результат:", a / b)
else:
    print("Невідома дія")
