def log(message):
    timestamp = datetime.datetime.now().strftime("[%H:%M:%S]")
    full_msg = f"{timestamp} {message}"
    print(full_msg)
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(full_msg + "\n")


def send_telegram_alert(text):
    try:
        requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage",
            data={"chat_id": CHAT_ID, "text": text}
        )
    except Exception as e:
        log(f"Ошибка отправки в Telegram: {e}")


def send_logs_to_telegram():
    if not os.path.exists(LOG_FILE):
        log("Файл логов не найден.")
        return
    try:
        with open(LOG_FILE, 'rb') as f:
            response = requests.post(
                f"https://api.telegram.org/bot{BOT_TOKEN}/sendDocument",
                data={"chat_id": CHAT_ID},
                files={"document": (LOG_FILE, f)}
            )
        if response.status_code == 200:
            log("Логи успешно отправлены.")
        else:
            log(f"Ошибка отправки логов: {response.status_code}")
    except Exception as e:
        log(f"Ошибка Telegram: {e}")


def is_scan_running():
    try:
        result = subprocess.run(
            ["powershell", "-Command", "Get-MpScanStatus | Select -ExpandProperty Running"],
            capture_output=True, text=True, check=True
        )
        return result.stdout.strip().lower() == "true"
    except:
        log("Не удалось проверить статус сканирования.")
        return False


def run_scan(scan_type, path=None):
    global cancel_requested
    if cancel_requested:
        log("Сканирование отменено.")
        return
    if is_scan_running():
        log("Сканирование уже идет.")
        return
    if scan_type == "quick":
        cmd = ["powershell", "Start-MpScan", "-ScanType", "QuickScan"]
    elif scan_type == "full":
        cmd = ["powershell", "Start-MpScan", "-ScanType", "FullScan"]
    elif scan_type == "custom" and path:
        cmd = ["powershell", "Start-MpScan", "-ScanPath", f'"{path}"']
    else:
        log("Неверный тип сканирования.")
        return
    log(f"Запуск {scan_type}-сканирования...")
    try:
        subprocess.run(" ".join(cmd), shell=True, check=True)
        if not cancel_requested:
            log("Сканирование завершено.")
    except subprocess.CalledProcessError:
        log("Ошибка при сканировании.")


def show_threats():
    try:
        result = subprocess.run(
            ["powershell", "-Command", "Get-MpThreat | Select ThreatName, Severity, ActionSuccess"],
            capture_output=True, text=True, check=True
        )
        output = result.stdout.strip()
        if output:
            log("Обнаруженные угрозы:\n" + output)
        else:
            log("Угроз не обнаружено.")
    except:
        log("Не удалось получить угрозы.")


def get_gpu_info():
    try:
        w = wmi.WMI()
        gpus = w.Win32_VideoController()
        return [f"{gpu.Name}, Память: {int(gpu.AdapterRAM) // (1024**2)} МБ, Статус: {gpu.Status}" for gpu in gpus]
    except Exception as e:
        return [f"Ошибка получения информации о видеокарте: {e}"]


def get_system_status():
    try:
        cpu_usage = psutil.cpu_percent(interval=1)
        ram = psutil.virtual_memory()
        ram_usage = ram.percent
        ram_total = round(ram.total / (1024 ** 3), 2)
        ram_used = round(ram.used / (1024 ** 3), 2)

        gpu_info = get_gpu_info()

        status = (
            f"CPU: {cpu_usage}%\n"
            f"RAM: {ram_used} ГБ из {ram_total} ГБ ({ram_usage}%)\n"
            f"GPU:\n" + "\n".join(gpu_info)
        )
        return status
    except Exception as e:
        log(f"Ошибка получения статуса системы: {e}")
        return "Ошибка получения статуса"


def analyze_activity():
    global alert_sent
    try:
        result = subprocess.run(["tasklist"], capture_output=True, text=True)
        processes = result.stdout.lower()

        suspicious_found = []
        heavy_processes = []

        for line in result.stdout.splitlines()[3:]:
            parts = line.split()
            if len(parts) < 5:
                continue
            name, pid, session_name, session_num, mem_usage = parts[0], parts[1], parts[2], parts[3], parts[4]
            mem_str = mem_usage.replace(",", "").replace("K", "").replace("k", "")
            try:
                mem_val = int(mem_str)
            except ValueError:
                continue
            if mem_val > 200000:
                heavy_processes.append(f"{name} - {mem_val / 1024:.1f} МБ")

        for item in BLACKLIST:
            if item in processes:
                suspicious_found.append(item)

        log("\n[Подозрительные/тяжелые процессы]")
        for proc in suspicious_found:
            log(f"Обнаружено: {proc}")
        for proc in heavy_processes:
            log(f"Тяжёлый процесс: {proc}")

        if suspicious_found and not alert_sent:
            send_telegram_alert(" Обнаружены подозрительные процессы! Проверьте систему!")
            send_logs_to_telegram()
            alert_sent = True
    except Exception as e:
        log(f"Ошибка при анализе: {e}")


def monitoring_loop():
    global monitoring_enabled, cancel_requested
    while monitoring_enabled and not cancel_requested:
        analyze_activity()
        for _ in range(60):
            if cancel_requested:
                log("Мониторинг отменён.")
                return
            time.sleep(1)


def start_monitoring():
    global monitoring_enabled
    if not monitoring_enabled:
        monitoring_enabled = True
        threading.Thread(target=monitoring_loop, daemon=True).start()
        send_telegram_alert("Мониторинг запущен.")
        log("Мониторинг запущен.")


def stop_monitoring():
    global monitoring_enabled
    monitoring_enabled = False
    send_telegram_alert("Мониторинг остановлен.")
    log("Мониторинг остановлен.")


def add_to_startup():
    try:
        script_path = os.path.abspath(sys.argv[0])
        key = winreg.OpenKey(winreg.HKEY_CURRENT_USER,
                             r"Software\Microsoft\Windows\CurrentVersion\Run",
                             0, winreg.KEY_SET_VALUE)
        winreg.SetValueEx(key, "SecurityMonitor", 0, winreg.REG_SZ, f'"{script_path}"')
        winreg.CloseKey(key)
        log("Добавлен в автозагрузку.")
    except Exception as e:
        log(f"Ошибка автозапуска: {e}")


