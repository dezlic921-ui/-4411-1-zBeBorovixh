def handle_telegram_commands():
    global cancel_requested, UNLOCK_PASSWORD
    last_update_id = None
    help_text = (
        "/start - Приветствие\n"
        "/help - Список команд\n"
        "/status - Текущий статус системы\n"
        "/logs - Показать нагрузку CPU, RAM и GPU\n"
        "/logs cpu - Топ процессов по загрузке CPU\n"
        "/logs ram - Топ процессов по использованию памяти\n"
        "/logs gpu - Информация о видеокартах\n"
        "/scan quick - Быстрое сканирование\n"
        "/scan full - Полное сканирование\n"
        "/scan <путь> - Кастомное сканирование папки\n"
        "/threats - Показать угрозы\n"
        "/startmonitor - Запустить мониторинг процессов\n"
        "/stop - Остановить мониторинг\n"
        "/lock - Заблокировать программу\n"
        "/unlock <пароль> - Разблокировать программу\n"
        "/addstartup - Добавить программу в автозагрузку\n"
        "/sendlogs - Отправить лог-файл\n"
    )
    while True:
        try:
            response = requests.get(
                f"https://api.telegram.org/bot{BOT_TOKEN}/getUpdates",
                params={"offset": last_update_id, "timeout": 10}
            )
            result = response.json().get("result", [])

            for update in result:
                last_update_id = update["update_id"] + 1
                message = update.get("message", {})
                text = message.get("text", "").strip()
                user_id = str(message.get("from", {}).get("id"))

                if user_id != CHAT_ID:
                    continue

                log(f"Команда из Telegram: {text}")
                cancel_requested = False

                if lock_state and not text.startswith("/unlock"):
                    send_telegram_alert("Программа заблокирована. Используйте /unlock <пароль> для разблокировки.")
                    continue

                if text == "/start":
                    send_telegram_alert("Привет! Я мониторю систему и могу отправлять уведомления. Используйте /help для списка команд.")
                elif text == "/help":
                    send_telegram_alert(help_text)
                elif text == "/status":
                    status = get_system_status()
                    send_telegram_alert(f"Статус системы:\n{status}")
                elif text == "/stop":
                    cancel_requested = True
                    stop_monitoring()
                elif text == "/startmonitor":
                    start_monitoring()
                elif text == "/sendlogs":
                    send_logs_to_telegram()
                elif text == "/scan quick":
                    threading.Thread(target=run_scan, args=("quick",), daemon=True).start()
                elif text == "/scan full":
                    threading.Thread(target=run_scan, args=("full",), daemon=True).start()
                elif text.startswith("/scan "):
                    path = text[6:].strip()
                    if path:
                        threading.Thread(target=run_scan, args=("custom", path), daemon=True).start()
                    else:
                        send_telegram_alert("Укажите путь для сканирования: /scan <путь>")
                elif text == "/threats":
                    show_threats()
                elif text == "/lock":
                    lock_program()
                elif text.startswith("/unlock"):
                    parts = text.split()
                    if len(parts) == 2:
                        unlock_program(parts[1])
                    else:
                        send_telegram_alert("Используйте: /unlock <пароль>")
                elif text == "/addstartup":
                    add_to_startup()
                elif text.startswith("/logs"):
                    parts = text.split()
                    if len(parts) == 1:
                        cpu_usage = psutil.cpu_percent(interval=1)
                        ram = psutil.virtual_memory()
                        ram_usage = ram.percent
                        ram_total = round(ram.total / (1024 ** 3), 2)
                        ram_used = round(ram.used / (1024 ** 3), 2)
                        gpu_info = get_gpu_info()
                        gpu_msg = "\n".join(gpu_info)

                        msg = (
                            f"Общая нагрузка системы:\n\n"
                            f"CPU: {cpu_usage}%\n"
                            f"RAM: {ram_used} ГБ из {ram_total} ГБ ({ram_usage}%)\n"
                            f"GPU:\n{gpu_msg}"
                        )
                        send_telegram_alert(msg)

                    elif len(parts) == 2:
                        sub_cmd = parts[1].lower()

                        if sub_cmd == "cpu":
                            procs = []
                            for proc in psutil.process_iter(['pid', 'name', 'cpu_percent']):
                                try:
                                    proc.cpu_percent(interval=None)
                                except (psutil.NoSuchProcess, psutil.AccessDenied):
                                    continue
                            time.sleep(1)
                            for proc in psutil.process_iter(['pid', 'name', 'cpu_percent']):
                                try:
                                    cpu = proc.cpu_percent(interval=None)
                                    if cpu > 0.5:
                                        procs.append((proc.info['name'], proc.info['pid'], cpu))
                                except (psutil.NoSuchProcess, psutil.AccessDenied):
                                    continue
                            procs.sort(key=operator.itemgetter(2), reverse=True)
                            if procs:
                                message_lines = ["Топ процессов по загрузке CPU:"]
                                for name, pid, cpu in procs[:10]:
                                    message_lines.append(f"{name} (PID: {pid}) - {cpu:.1f}% CPU")
                                send_telegram_alert("\n".join(message_lines))
                            else:
                                send_telegram_alert("Процессы с высокой загрузкой CPU не найдены.")

                        elif sub_cmd == "ram":
                            procs = []
                            for proc in psutil.process_iter(['pid', 'name', 'memory_info']):
                                try:
                                    mem = proc.memory_info().rss / (1024 ** 2)  # в МБ
                                    if mem > 10:  # минимум 10 МБ
                                        procs.append((proc.info['name'], proc.info['pid'], mem))
                                except (psutil.NoSuchProcess, psutil.AccessDenied):
                                    continue
                            procs.sort(key=operator.itemgetter(2), reverse=True)
                            if procs:
                                message_lines = ["Топ процессов по использованию памяти:"]
                                for name, pid, mem in procs[:10]:
                                    message_lines.append(f"{name} (PID: {pid}) - {mem:.1f} МБ RAM")
                                send_telegram_alert("\n".join(message_lines))
                            else:
                                send_telegram_alert("Процессы с высокой нагрузкой памяти не найдены.")

                        elif sub_cmd == "gpu":
                            gpu_info = get_gpu_info()
                            msg = "Статус видеокарты:\n" + "\n".join(gpu_info)
                            send_telegram_alert(msg)

                        else:
                            send_telegram_alert("Используйте: /logs cpu | /logs gpu | /logs ram")
                    else:
                        send_telegram_alert("Используйте: /logs или /logs cpu | /logs gpu | /logs ram")

                else:
                    send_telegram_alert("Неизвестная команда. Используйте /help для списка команд.")
        except Exception as e:
            log(f"Ошибка обработки команд: {e}")
            time.sleep(5)


if __name__ == "__main__":
    log("Запуск программы.")
    handle_telegram_commands()
